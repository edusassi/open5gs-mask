#!/bin/bash
# Helper executado na VM do UERANSIM, via sudo, pelo Open5GS Mask.
set -euo pipefail

GNB_BIN=${MASK_GNB_BIN:-/opt/UERANSIM/build/nr-gnb}
UE_BIN=${MASK_UE_BIN:-/opt/UERANSIM/build/nr-ue}
GNB_CFG=${MASK_GNB_CFG:-/opt/UERANSIM/config/open5gs-gnb.yaml}
LOG=${MASK_LOG_DIR:-/var/log/open5gs-mask}
CFG=${MASK_UE_CFG_DIR:-/opt/UERANSIM/config/mask}
TARGET=${MASK_IPERF_TARGET:-10.45.0.1}

mkdir -p "$LOG" "$CFG"

imsi_ok() {
  [[ "${1:-}" =~ ^[0-9]{15}$ ]]
}

cmd=${1:-}
shift || true

case "$cmd" in
  gnb-ensure)
    if pgrep -x nr-gnb >/dev/null 2>&1; then
      echo ALREADY
      exit 0
    fi
    : > "$LOG/gnb.log"
    setsid "$GNB_BIN" -c "$GNB_CFG" >> "$LOG/gnb.log" 2>&1 < /dev/null &
    for _ in $(seq 1 30); do
      if grep -q "NG Setup procedure is successful" "$LOG/gnb.log"; then
        echo OK
        exit 0
      fi
      if grep -Eq "NG Setup procedure is failed|Connection setup failed" "$LOG/gnb.log"; then
        echo FAIL
        exit 1
      fi
      sleep 1
    done
    echo TIMEOUT
    exit 1
    ;;
  ue-write)
    imsi=${1:-}
    imsi_ok "$imsi" || exit 2
    cat > "$CFG/ue-$imsi.yaml"
    chmod 600 "$CFG/ue-$imsi.yaml"
    echo WROTE
    ;;
  ue-ensure)
    imsi=${1:-}
    imsi_ok "$imsi" || exit 2
    if pgrep -f "config/mask/ue-$imsi.yaml" >/dev/null 2>&1; then
      echo ALREADY
      exit 0
    fi
    : > "$LOG/ue-$imsi.log"
    setsid "$UE_BIN" -c "$CFG/ue-$imsi.yaml" >> "$LOG/ue-$imsi.log" 2>&1 < /dev/null &
    echo STARTED
    ;;
  ue-ip)
    imsi=${1:-}
    imsi_ok "$imsi" || exit 2
    ns=$(ip netns list 2>/dev/null | awk -v i="$imsi" '$1 ~ i {print $1; exit}')
    if [ -n "${ns:-}" ]; then
      cidr=$(ip netns exec "$ns" ip -4 -o addr 2>/dev/null | awk '/uesimtun/ {print $4; exit}')
      if [ -n "${cidr:-}" ]; then
        echo "ns $ns ${cidr%%/*}"
        exit 0
      fi
    fi
    if [ -f "$LOG/ue-$imsi.log" ]; then
      line=$(grep -o 'TUN interface\[[^]]*\]' "$LOG/ue-$imsi.log" | tail -n 1 || true)
      if [[ ${line:-} =~ TUN\ interface\[([^,\ ]+),\ ([0-9.]+)\] ]]; then
        echo "host ${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
        exit 0
      fi
    fi
    echo NONE
    ;;
  suite)
    out=$(mktemp -d)
    while read -r imsi mode target ip up down secs; do
      [ -z "${imsi:-}" ] && continue
      imsi_ok "$imsi" || continue
      if [ "$mode" = "ns" ]; then
        ip netns exec "$target" iperf3 -4 -B "$ip" -c "$TARGET" -p "$up" -t "$secs" -i 1 -J > "$out/up-$imsi.json" 2> "$out/up-$imsi.err" &
        ip netns exec "$target" iperf3 -4 -B "$ip" -c "$TARGET" -p "$down" -t "$secs" -i 1 -R -J > "$out/down-$imsi.json" 2> "$out/down-$imsi.err" &
        ip netns exec "$target" ping -4 -n -D -I "$ip" -i 1 -c "$secs" "$TARGET" > "$out/ping-$imsi.txt" 2> "$out/ping-$imsi.err" &
      else
        iperf3 -4 -B "$ip" -c "$TARGET" -p "$up" -t "$secs" -i 1 -J > "$out/up-$imsi.json" 2> "$out/up-$imsi.err" &
        iperf3 -4 -B "$ip" -c "$TARGET" -p "$down" -t "$secs" -i 1 -R -J > "$out/down-$imsi.json" 2> "$out/down-$imsi.err" &
        ping -4 -n -D -I "$ip" -i 1 -c "$secs" "$TARGET" > "$out/ping-$imsi.txt" 2> "$out/ping-$imsi.err" &
      fi
    done
    wait || true
    for f in "$out"/*; do
      [ -f "$f" ] || continue
      echo "===== $(basename "$f") ====="
      cat "$f"
      echo
    done
    rm -rf "$out"
    ;;
  ping)
    imsi=${1:-}
    count=${2:-20}
    imsi_ok "$imsi" || exit 2
    [[ "$count" =~ ^[0-9]+$ ]] || exit 2
    if [ "$count" -lt 5 ] || [ "$count" -gt 60 ]; then exit 2; fi
    info=$(/usr/local/sbin/mask-ran ue-ip "$imsi")
    set -- $info
    mode=$1
    target=$2
    ipaddr=$3
    if [ "$mode" = "ns" ]; then
      ip netns exec "$target" ping -4 -n -D -I "$ipaddr" -i 1 -c "$count" "$TARGET"
    elif [ "$mode" = "host" ]; then
      ping -4 -n -D -I "$ipaddr" -i 1 -c "$count" "$TARGET"
    else
      echo NONE
      exit 1
    fi
    ;;
  log)
    name=${1:-}
    case "$name" in
      gnb) tail -n 120 "$LOG/gnb.log" 2>/dev/null || true ;;
      ue)
        imsi=${2:-}
        imsi_ok "$imsi" || exit 2
        tail -n 120 "$LOG/ue-$imsi.log" 2>/dev/null || true
        ;;
      *) exit 2 ;;
    esac
    ;;
  status)
    if pgrep -x nr-gnb >/dev/null 2>&1; then echo "GNB 1"; else echo "GNB 0"; fi
    if [ -f "$LOG/gnb.log" ]; then
      grep -E "NG Setup procedure is successful|SCTP connection established" "$LOG/gnb.log" | tail -n 1 || true
    fi
    mapfile -t tuns < <(ip -4 -o addr 2>/dev/null | awk '/uesimtun/ { split($4, a, "/"); print $2, a[1] }')
    idx=0
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      cfg=$(sed -n 's/.* -c \([^ ]*\).*/\1/p' <<< "$line")
      imsi=""
      if [ -n "${cfg:-}" ] && [ -f "$cfg" ]; then
        imsi=$(grep -m1 'supi:' "$cfg" | grep -oE '[0-9]{15}' || true)
      fi
      tun="${tuns[$idx]:-}"
      iface=$(awk '{print $1}' <<< "$tun")
      addr=$(awk '{print $2}' <<< "$tun")
      echo "UE ${imsi:-unknown} ${iface:--} ${addr:-}"
      idx=$((idx + 1))
    done < <(pgrep -a nr-ue || true)
    ;;
  *)
    echo "comando invalido" >&2
    exit 2
    ;;
esac
